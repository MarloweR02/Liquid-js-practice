<div class="product-card">
  <div class="product-card__image">
    {{ product.featured_image |  image_url: width: 500 |  image_tag  }}
  </div>
  <div class="product-card__content">
    <span class="product-card__title">{{ product.title }}</span>
    <div class="product-card__prices">
      <span class="product-card__sale-price">{{ product.price | money }}</span>
      <span class="product-card__original-price">{{ product.compare_at_price | money }}</span>
    </div>
    {% comment %} <div class="product-card__variants"></div> {% endcomment %}
     <button class="product-card__atc-button">Add to cart</button>
  </div>
</div>

<style>
  @media (max-width: 767px) {
    .product-card__image{
      aspect-ratio: 1/1;
    }
    .product-card__image > img{
      width: 100%;
      height: 100%;
    }

    .product-card{
      border: 1px solid rgb(225, 225, 225);
      padding: .8rem;
      border-radius: .4rem;
    }

    .product-card__prices{
      display: flex;
      gap: .4rem;
      align-items: center;
    }
    
    .product-card__original-price{
      text-decoration: line-through;
      color: gray;
      font-size: 1.4rem;
    }

    .product-card__atc-button{
      background-color: black;
      color: white;
      width: 100%;
      padding: .8rem 0;
      border: none;
      border-radius: .4rem; 
      margin-top: 1.6rem;
      font-weight: bold;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
