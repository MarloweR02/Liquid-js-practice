<div class="header">
  <div class="page-width header__wrapper">
    <div class="header__left">
      {% if settings.image_picker != blank %}
        <div class="header__logo">
          {{ settings.image_picker | image_url: width: 700 | image_tag }}
        </div>
      {% else %}
        <h1 class="header__logo-name">{{ shop.name }}</h1>
      {% endif %}
      {% if section.settings.menu != blank %}
        <ul class="header__nav">
          {% for link in section.settings.menu.links %}
            <li class="header__nav-item">{{ link.title }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    <div class="header__right">
      <div class="header__search svg-wrapper">{{ "icon-search.svg" | inline_asset_content }}</div>
      <div class="header__user svg-wrapper">{{ "icon-user.svg" | inline_asset_content }}</div>
      <div class="header__cart  svg-wrapper">{{ "icon-shopping-cart.svg" | inline_asset_content }}</div>
    </div>
  </div>
</div>

<style>
  .header{
    padding: 1rem 0;
  }
  .header__wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header__left {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .header__right {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
  }

  .header__nav {
    display: flex;
    list-style: none;
    gap: 1.2rem;
  }
</style>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "link_list",
        "id": "menu",
        "label": "Menu",
        "default": "main-menu"
      }
    ],
    "presets": [
      {
        "name": "Header"
      }
    ]
  }
{% endschema %}