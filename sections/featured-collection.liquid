<div class="featured-collection">
  <div class="page-width featured-collection__wrapper">
    <div class="featured-collection__header">
      <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
      <p class="featured-collection__description">{{ section.settings.description }}</p>
    </div>
    <div class="featured-collection__body">
      {% for product in section.settings.collection.products limit: 4 %}
        {% render 'product-card'
          , product: product %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .featured-collection {
    padding: 6rem 0;
  }
  .featured-collection__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .featured-collection__body {
    margin-top: 6rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.6rem;
  }
</style>


{% schema %}
  {
    "name": "Featured collection",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      }, {
        "type": "inline_richtext",
        "id": "description",
        "label": "Description"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      }
    ],
    "presets": [
      {
        "name": "Featured collection"
      }
    ]
  }
{% endschema %}